<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Psicotrap J | Audio-Visual Universe</title>

<link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Outfit:wght@100;300&display=swap" rel="stylesheet">

<style>
:root {
    --cyan: #00f2ff;
    --fuchsia: #ff00e0;
    --dark: #030303;
}

body, html {
    margin:0; padding:0;
    width:100%; height:100%;
    background-color: var(--dark);
    color:white;
    font-family:'Outfit',sans-serif;
    overflow:hidden;
}

/* NAV */
.nav-container{
    position:absolute;
    width:100%; height:100%;
}
.nav-item{
    position:absolute;
    cursor:pointer;
    text-align:center;
}
.nav-item:nth-child(1){ top:20%; left:6%; }

.icon-abstract{
    width:80px; height:80px;
    stroke:rgba(255,255,255,0.3);
    fill:none;
}

/* =========================
POPUP NEON EVAPORACIÓN
========================= */
#origen-modal{
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;

    background: radial-gradient(circle at center, rgba(0,242,255,0.06), rgba(0,0,0,0.96));
    backdrop-filter: blur(14px);

    display:flex;
    justify-content:center;
    align-items:center;

    opacity:0;
    pointer-events:none;
    transition: opacity 0.8s ease;
    z-index:999;
}

#origen-modal.active{
    opacity:1;
    pointer-events:all;
}

.origen-content{
    position:relative;
    width:60%;
    max-width:800px;
    padding:50px;

    background: rgba(3,3,3,0.7);
    border:1px solid rgba(0,242,255,0.2);
    border-radius:14px;

    box-shadow:
        0 0 40px rgba(0,242,255,0.1),
        0 0 80px rgba(255,0,224,0.06),
        inset 0 0 40px rgba(0,0,0,0.8);

    transform: scale(0.7);
    opacity:0;
    filter: blur(25px);

    transition:
        transform 0.8s cubic-bezier(0.23,1,0.32,1),
        opacity 0.6s ease,
        filter 0.8s ease;
}

#origen-modal.active .origen-content{
    transform: scale(1);
    opacity:1;
    filter: blur(0);
}

.origen-content h2{
    font-family:'Syncopate';
    letter-spacing:8px;
    color:var(--cyan);
    text-shadow:0 0 20px var(--cyan);
}

.origen-content p{
    color:rgba(255,255,255,0.7);
}

.close-btn{
    position:absolute;
    top:20px;
    right:30px;
    cursor:pointer;
    font-size:20px;
    color:rgba(255,255,255,0.5);
}
.close-btn:hover{
    color:var(--fuchsia);
    text-shadow:0 0 10px var(--fuchsia);
}
</style>
</head>

<body>

<!-- NAV -->
<div class="nav-container">

    <!-- EL ORIGEN -->
    <a href="#" onclick="abrirOrigen(event)" class="nav-item">
        <svg class="icon-abstract" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="40" stroke-dasharray="2,4"/>
            <path d="M50 10 L50 90 M10 50 L90 50" stroke-width="0.5"/>
        </svg>
        <span>EL ORIGEN</span>
    </a>

</div>

<!-- POPUP -->
<div id="origen-modal">
    <div class="origen-content">
        <span class="close-btn" onclick="cerrarOrigen()">✕</span>

        <h2>EL ORIGEN</h2>
        <p>
            Este es tu espacio narrativo.<br><br>
            Podés contar tu historia, concepto artístico,
            universo creativo o identidad sonora.
        </p>
    </div>
</div>

<script>
function abrirOrigen(e){
    e.preventDefault();
    document.getElementById("origen-modal").classList.add("active");
}

function cerrarOrigen(){
    document.getElementById("origen-modal").classList.remove("active");
}
</script>

</body>
</html>
